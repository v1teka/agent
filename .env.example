# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Admins: your Telegram id (send /id to the bot to see it). Comma-separated.
# Admins have no limits, get a note about every new user and can use /stats, /block, /unblock.
ADMIN_USER_IDS=
# public: anyone can talk to the bot within the limits below.
# private: only admins and ALLOWED_USER_IDS.
ACCESS=public
ALLOWED_USER_IDS=

# Limits for everyone except admins. Spend is estimated from tokens and the prices below.
USER_DAILY_BUDGET_USD=0.50
GLOBAL_DAILY_BUDGET_USD=3.00
USER_MESSAGES_PER_MINUTE=5
USER_MESSAGES_PER_DAY=60
MAX_MESSAGE_CHARS=2000
# USD per million tokens for CLAUDE_MODEL (defaults are claude-opus-5-5)
PRICE_INPUT_PER_MTOK=4.00
PRICE_OUTPUT_PER_MTOK=20.00
PRICE_CACHE_READ_PER_MTOK=0.40
PRICE_CACHE_WRITE_PER_MTOK=5.00

TIMEZONE=Europe/Moscow
ROLE=mentor
MORNING_AT=09:00
EVENING_AT=21:30
QUIET_START=23:00
QUIET_END=08:00
# Max messages per day the bot sends on its own
DAILY_MESSAGE_BUDGET=4

CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
DB_PATH=data/agent.db
