# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Your Telegram id (the bot tells it to you if you write to it while this is set to someone else).
# Comma-separated. Leave empty only for a first test: then anyone can use the bot.
ALLOWED_USER_IDS=

TIMEZONE=Europe/Moscow
ROLE=mentor
MORNING_AT=09:00
EVENING_AT=21:30
QUIET_START=23:00
QUIET_END=08:00
# Max messages per day the bot sends on its own
DAILY_MESSAGE_BUDGET=4

CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
DB_PATH=data/proactive.db
